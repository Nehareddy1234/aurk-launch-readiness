FLASK_CONFIG=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=mysql+pymysql://ar_drips_user:change-me@localhost:3306/ar_drips
SESSION_COOKIE_SECURE=false
RATELIMIT_STORAGE_URI=memory://
# Set only when Gunicorn is reachable exclusively through the trusted proxy.
TRUSTED_PROXY_COUNT=0
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
GUNICORN_WORKERS=2
UPLOAD_DIR=instance/uploads
MAX_CONTENT_LENGTH=104857600
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=''

# Public HTTPS website URL used in owner alert links (no trailing slash).
PUBLIC_BASE_URL=
ORDER_ALERT_EMAIL=
ORDER_ALERT_WHATSAPP=
MAIL_FROM=
MAIL_USE_TLS=true
MAIL_USE_SSL=false
# Meta WhatsApp Cloud API; use a supported version from your Meta dashboard.
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ORDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Dedicated admin session expiry, in seconds (30 minute idle / 8 hour maximum).
ADMIN_SESSION_IDLE_SECONDS=1800
ADMIN_SESSION_MAX_SECONDS=28800

# Optional Docker only. Use new strong passwords; URL-encode the password in the URL.
# Connect to the Compose service named db, not localhost:
# DOCKER_DATABASE_URL=mysql+pymysql://ar_drips_user:URL_ENCODED_PASSWORD@db:3306/ar_drips
DOCKER_DATABASE_URL=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Compose uses production and secure cookies for web, migrations and workers.
# Put an HTTPS reverse proxy in front; use Flask development mode separately for HTTP previews.
# Production behind exactly one trusted reverse proxy: DOCKER_TRUSTED_PROXY_COUNT=1

# Business inbox for product interest notifications (uses existing MAIL_* SMTP settings).
INTEREST_NOTIFICATION_EMAIL=

# Google OAuth web client. Register the exact callback URI in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Leave all three OAuth values blank when Google sign-in is disabled.
GOOGLE_REDIRECT_URI=

# Enable only after Brevo credentials and controlled-inbox delivery are tested.
CUSTOMER_EMAILS_ENABLED=false
CUSTOMER_SUPPORT_EMAIL=support@aurk.in
CUSTOMER_NOREPLY_EMAIL=no-reply@aurk.in

# Public production only. Keep false in previews/staging.
SEARCH_INDEXING_ENABLED=false
GOOGLE_SITE_VERIFICATION=
# Set only confirmed business details, or save them in Admin > Business & delivery.
BUSINESS_LEGAL_NAME=
BUSINESS_ADDRESS=
BUSINESS_RETURN_ADDRESS=
BUSINESS_GRIEVANCE_NAME=
BUSINESS_GRIEVANCE_EMAIL=
BUSINESS_GSTIN=
